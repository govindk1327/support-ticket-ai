# Copy to .env and fill in. Never commit the real .env -- it is git-ignored.
#
# The system runs at zero cost either way:
#   * Groq  -- free tier, no credit card required, just a key
#   * Ollama -- fully local, no account at all
#
# With no key set, the API still starts: /health, /meta and /anomalies all work
# (anomaly detection is fully deterministic). Only /query needs a provider.

# --- Provider selection ----------------------------------------------------
LLM_PROVIDER=groq
# Tried only if the primary is unreachable. Set to "none" to disable.
LLM_FALLBACK_PROVIDER=ollama

# --- Groq (primary) --------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Free-tier production model, verified September 2026.
# openai/gpt-oss-20b is faster and lighter if rate limits bite.
# NOTE: llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise-only.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (local fallback) ----------------------------------------------
# Install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Translation tuning ----------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
MAX_QUESTION_LENGTH=500

# --- UI --------------------------------------------------------------------
API_URL=http://localhost:8000
